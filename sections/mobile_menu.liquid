{%- assign block = section.blocks.first -%}{%- comment -%}Workaround for Theme check UndefinedObject block in "visibile_if"{%- endcomment -%}

{%- assign tabBlocks = section.blocks | where: 'type', 'tab' -%}
{%- assign notTabBlocks = section.blocks | reject: 'type', 'tab' -%}
{%- assign tabButtons = blank -%}
{%- assign tabPanels = blank -%}
{%- assign featuredCollections = blank -%}
{%- assign featuredCollectionsFirstLevel = blank -%}

{%- for tabBlock in tabBlocks -%}
  {%- capture tabButtons -%}
    {%- if tabBlock.settings.title != blank -%}
      {{tabButtons}}
      <button class="util-tab {{section.settings.tab_style}} text-center" type="button" role="tab" aria-selected="true" data-block="{{tabBlock.id}}" id="btn-block-{{tabBlock.id}}" aria-controls="content-block-{{tabBlock.id}}" {{ tabBlock.shopify_attributes }}>
        {% if section.settings.tab_active_icon %}
        <div class="hide icon-active">
          <img alt="" class="lazyload" data-sizes="auto" src="{% render 'image_placeholder', image: section.settings.tab_active_icon %}" data-srcset="{% render 'lazy_src', image: section.settings.tab_active_icon %}" width="{{ section.settings.tab_active_icon.width }}" height="{{ section.settings.tab_active_icon.height }}" {% if section.settings.tab_active_icon.presentation.focal_point != blank %}style="object-position: {{section.settings.tab_active_icon.presentation.focal_point}};"{% endif %} />
        </div>
        {% endif %}
        {{tabBlock.settings.title}}
      </button>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture tabPanels -%}
    {{tabPanels}}
    {%- if tabBlocks.size > 1 -%}
    <div tabindex="0" role="tabpanel" id="content-block-{{tabBlock.id}}" aria-labelledby="btn-block-{{tabBlock.id}}" {% if forloop.index > 1 %} hidden="hidden"{% endif %} {{ tabBlock.shopify_attributes }}>
    {%- endif -%}
      <div class="tab-content">
        <div class="main-list {{section.settings.font_style}} borders-{{section.settings.borders}}">
          {%- for first_link in linklists[tabBlock.settings.main_menu_mobile].links -%}
            {%- if section.settings.mobile_menu_submenu_animation == 'slide' -%}
              {%- assign submenuClass = 'slide ease-animation' -%}
              {%- assign arrowIcon = 'chevron-right' -%}
            {%- else -%}
              {%- assign submenuClass = 'expandable' -%}
              {%- assign arrowIcon = 'chevron-down' -%}
            {%- endif -%}
            {%- assign hasBlock = false -%}
            {%- if notTabBlocks.size > 0 -%}
              {%- capture blocksContent -%}
                {%- for block in notTabBlocks -%}
                  {%- assign customIcon = false -%}
                  {%- if block.settings.parent_link == first_link.title -%}
                    {%- if block.type == 'icon' -%}
                      {%- assign customIcon = true -%}
                      {%- render 'icons', icon: block.settings.icon -%}
                      {%- break -%}
                    {%- else -%}
                      {%- assign hasBlock = true -%}
                    {%- endif -%}
                    {%- if block.type == 'featured_banner' -%}
                      <div class="grid-item {{block.settings.width}} block-{{block.id}}">
                        <style>#mobile-menu .block-{{block.id}} {--img-simple-border-radius: {{block.settings.image_border_radius}}em;}</style>
                        {% render 'img_simple_overlay', imageLink: block.settings.image_link, image: block.settings.image, text: block.settings.image_text, textShadow: block.settings.image_text_shadow, colorScheme: block.settings.image_text_color, textPosition: block.settings.image_text_position, textAlign: block.settings.image_text_align, cta: block.settings.image_cta, ctaStyle: block.settings.image_cta_style %}
                      </div>
                    {%- endif -%}
                    {%- if block.type == 'button' -%}
                      <div class="grid-item {{block.settings.width}} block-{{block.id}} flex align-items-center">
                        <a href="{{block.settings.button_link}}" class="{{block.settings.cta_style}} {% if block.settings.cta_style contains 'btn' %}{{section.settings.cta_size}}{% endif %}">{{block.settings.button}}</a>
                      </div>
                    {%- endif -%}

                    {%- if block.type == 'featured_collections' -%}
                      {%- capture itemsHtml -%}
                        {%- for col in block.settings.collections -%}
                        <div class="keen-slider-slide" {{block.shopify_attributes}}>
                          {%- render 'collection_card', collection: col, block: block, cardSettings: block.settings -%}
                        </div>
                        {%- endfor -%}
                      {%- endcapture -%}
                      {%- capture featuredCollections -%}
                        {{featuredCollections}}
                        <div class="featured-collections block-{{block.id}} {% if block.settings.collection_custom_settings %}custom-settings{% endif %}">
                          {%- render 'featured_collections_mobile_menu', block: block, cardType: 'collection', itemsHtml: itemsHtml -%}
                        </div>
                      {%- endcapture -%}
                    {%- endif -%}

                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
            {%- endif -%}
            <div class="item{% if first_link.links != blank or hasBlock %} has-dropdown{% endif %}">
              <div class="item-inner flex align-items-center justify-content-between">
                {%- assign linkUrlLastChar = first_link.url | slice: -1 -%}
                <a class="flex item-padding" href="{{ first_link.url }}" {% if linkUrlLastChar == '#' %}aria-hidden="true" role="button" tabindex="-1" data-notab="1" onclick="this.parentNode.querySelector('button').click(); return false;"{% endif %}>
                  {%- assign titlePart = first_link.title | split: '**' -%}
                  <div class="flex flex-wrap align-items-center">
                    <span class="title">{{ titlePart[0] | strip }}</span> {%- if titlePart.size > 1 -%}<div class="badge">{{titlePart[1] | strip}}</div>{%- endif -%}
                  </div>
                </a>
                {%- if first_link.links != blank or hasBlock -%}
                  <button aria-expanded="false" aria-label="{{ 'mobile_menu.toggle_submenu_caption' | t: submenu_title: titlePart[0] | escape }}">{% render 'icons', icon: arrowIcon %}</button>
                {%- elsif customIcon -%}
                  {{blocksContent}}
                {%- endif -%}
              </div>
              {%- if first_link.links != blank or hasBlock -%}
                <div class="submenu {{submenuClass}} scheme color-{{section.settings.main_color_scheme}}">
                  <div class="submenu-inner">
                    {%- render 'mobile_menu_level', parent_link: first_link, submenuClass: submenuClass, arrowIcon: arrowIcon, section: section -%}
                    {%- if hasBlock and blocksContent != blank-%}
                      <div class="featured-banners">
                        <div class="grid">
                          {{blocksContent}}
                        </div>
                      </div>
                    {%- endif -%}
                    {%- if featuredCollections != blank -%}
                      {{featuredCollections}}
                      {%- assign featuredCollections = blank -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          {%- comment -%}TAB LEVEL BLOCKS{%- endcomment -%}
          {%- assign hasBlockFirstLevel = false -%}
          {%- if notTabBlocks.size > 0 -%}
            {%- capture blocksContentFirstLevel -%}
              {%- for block in notTabBlocks -%}
                {%- if block.settings.parent_link == tabBlock.settings.title -%}
                  {%- assign hasBlockFirstLevel = true -%}
                  {%- if block.type == 'featured_banner' -%}
                    <div class="grid-item {{block.settings.width}} block-{{block.id}}">
                      <style>#mobile-menu .block-{{block.id}} {--img-simple-border-radius: {{block.settings.image_border_radius}}em;}</style>
                      {% render 'img_simple_overlay', imageLink: block.settings.image_link, image: block.settings.image, text: block.settings.image_text, textShadow: block.settings.image_text_shadow, colorScheme: block.settings.image_text_color, textPosition: block.settings.image_text_position, textAlign: block.settings.image_text_align, cta: block.settings.image_cta, ctaStyle: block.settings.image_cta_style %}
                    </div>
                  {%- endif -%}
                  {%- if block.type == 'button' -%}
                    <div class="grid-item {{block.settings.width}} block-{{block.id}} flex align-items-center">
                      <a href="{{block.settings.button_link}}" class="{{block.settings.cta_style}} {% if block.settings.cta_style contains 'btn' %}{{section.settings.cta_size}}{% endif %}">{{block.settings.button}}</a>
                    </div>
                  {%- endif -%}
                  {%- if block.type == 'featured_collections' -%}
                    {%- capture itemsHtml -%}
                      {%- for col in block.settings.collections -%}
                      <div class="keen-slider-slide" {{block.shopify_attributes}}>
                        {%- render 'collection_card', collection: col, block: block, cardSettings: block.settings -%}
                      </div>
                      {%- endfor -%}
                    {%- endcapture -%}
                    {%- capture featuredCollectionsFirstLevel -%}
                      {{featuredCollectionsFirstLevel}}
                      <div class="featured-collections block-{{block.id}} {% if block.settings.collection_custom_settings %}custom-settings{% endif %}">
                        {%- render 'featured_collections_mobile_menu', block: block, cardType: 'collection', itemsHtml: itemsHtml -%}
                      </div>
                    {%- endcapture -%}
                  {%- endif -%}

                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
          {%- endif -%}
          {%- if hasBlockFirstLevel -%}
            {%- if blocksContentFirstLevel != blank-%}
              <div class="featured-banners">
                <div class="grid">
                  {{blocksContentFirstLevel}}
                </div>
              </div>
            {%- endif -%}
            {%- if featuredCollectionsFirstLevel != blank -%}
              {{featuredCollectionsFirstLevel}}
              {%- assign featuredCollectionsFirstLevel = blank -%}
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="secondary-list">
          {%- for first_link in linklists[tabBlock.settings.secondary_menu_mobile].links -%}
            <div class="item{% if first_link.links != blank or hasBlock %} has-dropdown{% endif %}">
              <div class="item-inner flex align-items-center justify-content-between">
                {%- assign linkUrlLastChar = first_link.url | slice: -1 -%}
                <a class="flex item-padding" href="{{ first_link.url }}" {% if linkUrlLastChar == '#' %}aria-hidden="true" role="button" tabindex="-1" data-notab="1" onclick="this.parentNode.querySelector('button').click(); return false;"{% endif %}>
                  {%- assign titlePart = first_link.title | split: '**' -%}
                  <div class="flex flex-wrap align-items-center">
                    <span>{{ titlePart[0] | strip }}</span> {%- if titlePart.size > 1 -%}<div class="badge">{{titlePart[1] | strip}}</div>{%- endif -%}
                  </div>
                </a>
                {%- if first_link.links != blank or hasBlock -%}
                  <button aria-expanded="false" aria-label="{{ 'mobile_menu.toggle_submenu_caption' | t: submenu_title: titlePart[0] | escape }}">{% render 'icons', icon: arrowIcon %}</button>
                {%- endif -%}
              </div>
              {%- if first_link.links != blank or hasBlock -%}
                <div class="submenu {{submenuClass}} scheme color-{{section.settings.main_color_scheme}}">
                  <div class="submenu-inner">
                    {%- render 'mobile_menu_level', parent_link: first_link, submenuClass: submenuClass, arrowIcon: arrowIcon, section: section -%}
                    {%- if hasBlock and blocksContent != blank -%}
                      <div class="featured-banners">
                        <div class="grid">
                          {{blocksContent}}
                        </div>
                      </div>
                    {%- endif -%}
                    {%- if featuredCollections != blank -%}
                      {{featuredCollections}}
                      {%- assign featuredCollections = blank -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- if tabBlocks.size > 1 -%}
    </div>
    {%- endif -%}
  {%- endcapture -%}
{%- endfor -%}

{%- capture tabsHtml -%}
  {%- if tabBlocks.size > 1 -%}
  <util-tabs data-match-height="false">
    <div class="tabs-outer {% if section.settings.sticky_tabs %}sticky{% endif %} {% if section.settings.tabs_show_scroll_hint %}scrollable-overlay{% endif %} content-{{section.settings.tabs_width}} tabs-style-{{section.settings.tab_style}} {% if section.settings.tabs_full_width %}tabs-full-width{% endif %} {% if section.settings.tabs_bordered %}tabs-bordered{% endif %} scheme color-{{section.settings.tabs_color_scheme}} {% if section.settings.tabs_border_bottom %}scheme-border-bottom{% endif %}" {% unless tabBlocks.size > 1 %}style="display:none;"{% endunless %}>
      <div class="tabs-inner flex">
        <div class="tabs-wrap flex flex-wrap" role="tablist" aria-label="{{section.settings.tabs_title}}">
          {{tabButtons}}
        </div>
      </div>
    </div>
    {{tabPanels}}
  </util-tabs>
  <script src="{{ 'util_tabs.js' | asset_url }}" defer="defer"></script>
  {%- else -%}
    {{tabPanels}}
  {%- endif -%}
{%- endcapture -%}

<style type="text/css">
  #mobile-menu {
    --font-size: {{section.settings.font_size}}%;
    --font-weight: {{section.settings.font_weight}};
    --text-transform: {{section.settings.text_transform}};
    --letter-spacing: {{section.settings.letter_spacing | divided_by: 10.00}}em;
    --tab-border-radius: {{section.settings.tab_border_radius}}em;
    --tab-margin: {{section.settings.tab_margin}}em;
    --tabs-content-padding: {{section.settings.content_padding}}em;
    --tab-vertical-padding: {{section.settings.tab_vertical_padding}}em;
    --tab-horizontal-padding: {{section.settings.tab_horizontal_padding}}em;
    --tab-icon-active-size: {{section.settings.tab_active_icon_width}}em;
  }
</style>
{{ 'mobile_menu.css' | asset_url | stylesheet_tag }}

<mobile-menu id="mobile-menu" class="ease-animation from-{{section.settings.mobile_menu_position}} slide-in-modal" {% if section.settings.top_position == 'below-header' %} data-top-position="{{section.settings.top_position}}"{% endif %} role="dialog" aria-modal="true">
  <div class="wrapper flex direction-column">
    <div class="head scheme color-{{section.settings.heading_color_scheme}} {% if section.settings.heading_border %}scheme-border-bottom{% endif %}">
      <div class="title">{{ 'mobile_menu.title' | t }}</div>
      <button class="close" aria-label="{{ 'mobile_menu.close_caption' | t | escape }}">
        {% render 'icons', icon: 'close' %}
      </button>
    </div>
    <div class="content scheme color-{{section.settings.main_color_scheme}} flex direction-column flex-1">
      <nav class="menu-links flex-1 flex direction-column" role="navigation">
        {%- if section.settings.show_search -%}
          <div class="extras top scheme color-{{section.settings.extras_color_scheme}} {% if section.settings.extras_border %}scheme-border-bottom{% endif %}">
            <div class="item search">
              <div class="item-inner">
                <div class="item-padding">
                  {%- render 'search_form', color_scheme: section.settings.main_color_scheme -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
        <div class="middle-content flex-1">
          {%- comment -%}TABS + PANELS{%- endcomment -%}
          {{tabsHtml}}

          {%- assign hasBlock = false -%}
          {%- assign featuredCollections = blank -%}
          {%- if notTabBlocks.size > 0 -%}
            {%- capture blocksContent -%}
              {%- for block in notTabBlocks -%}
                {%- if block.settings.parent_link == blank or block.settings.parent_link == '' -%}
                  {%- assign hasBlock = true -%}
                  {%- if block.type == 'featured_banner' -%}
                    <div class="grid-item {{block.settings.width}} block-{{block.id}}">
                      <style>#mobile-menu .block-{{block.id}} {--img-simple-border-radius: {{block.settings.image_border_radius}}em;}</style>
                      {% render 'img_simple_overlay', imageLink: block.settings.image_link, image: block.settings.image, text: block.settings.image_text, textShadow: block.settings.image_text_shadow, textPosition: block.settings.image_text_position, textAlign: block.settings.image_text_align, cta: block.settings.image_cta, ctaStyle: block.settings.image_cta_style %}
                    </div>
                  {%- elsif block.type == 'button' -%}
                    <div class="grid-item {{block.settings.width}} block-{{block.id}} flex align-items-center">
                      <a href="{{block.settings.button_link}}" class="{{block.settings.cta_style}} {% if block.settings.cta_style contains 'btn' %}{{section.settings.cta_size}}{% endif %}">{{block.settings.button}}</a>
                    </div>
                  {%- elsif block.type == 'featured_collections' -%}
                    {%- capture itemsHtml -%}
                      {%- for col in block.settings.collections -%}
                      <div class="keen-slider-slide" {{block.shopify_attributes}}>
                        {%- render 'collection_card', collection: col, block: block, cardSettings: block.settings -%}
                      </div>
                      {%- endfor -%}
                    {%- endcapture -%}
                    {%- capture featuredCollections -%}
                      {{featuredCollections}}
                      <div class="featured-collections featured-collections-first-level block-{{block.id}} {% if block.settings.collection_custom_settings %}custom-settings{% endif %}">
                        {%- render 'featured_collections_mobile_menu', block: block, cardType: 'collection', itemsHtml: itemsHtml -%}
                      </div>
                    {%- endcapture -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if hasBlock -%}
              {%- if blocksContent != blank -%}
              <div class="featured-banners">
                <div class="grid">
                  {{blocksContent}}
                </div>
              </div>
              {%- endif -%}
              {%- if featuredCollections != blank -%}
                {{featuredCollections}}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}

        </div>
        <div class="extras bottom scheme color-{{section.settings.extras_color_scheme}} {% if section.settings.extras_border %}scheme-border-top{% endif %}">
          {%- if section.settings.show_login -%}
            <div class="item">
              <div class="item-inner">
                <a class="item-padding flex align-items-center" {% if customer %}href="/account"{% else %}href="/account/login"{% endif %}>
                  {%- render 'icons', icon: 'user' -%}
                  {%- if customer -%}
                    <span>{{ 'mobile_menu.my_account_link' | t }}</span>
                  {%- else -%}
                    <span>{{ 'mobile_menu.login_link' | t }}</span>
                  {%- endif -%}
                </a>
              </div>
            </div>
          {%- endif -%}
          {%- if settings.show_currency_selector_header -%}
            <div class="item">
              <div class="item-inner">
                <div class="item-padding flex align-items-center">
                  {%- render 'currency_selector' -%}
                </div>
              </div>
            </div>
          {%- endif -%}
          {%- if settings.show_language_selector_header -%}
            <div class="item">
              <div class="item-inner">
                <div class="item-padding flex align-items-center">
                  {%- render 'language_selector' -%}
                  <span>{{ 'mobile_menu.language_label' | t}}</span>
                </div>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.show_social_links -%}
            <div class="item">
              <div class="item-inner">
                <div class="item-padding flex align-items-center">
                  {%- render 'social_links' -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </nav>
    </div>
  </div>
</mobile-menu>

<script src="{{ 'mobile_menu.js' | asset_url }}" defer="defer"></script>
{% if request.design_mode %}
<script type="module">
  var section = document.getElementById('shopify-section-{{section.id}}');
  section.addEventListener('shopify:section:select', (e)=>{
    section.querySelector('mobile-menu').open();
  });
  section.addEventListener('shopify:section:deselect', (e)=>{
    section.querySelector('mobile-menu').close();
  });
  section.addEventListener('shopify:block:select', (e)=>{
    if(e.target.classList.contains('util-tab')){
      e.target.closest('util-tabs').activateTab(e.target);
    }
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Menu Mobile",
  "class": "type-menu-mobile",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "radio",
      "id": "mobile_menu_position",
      "label": "Open style",
      "options": [
        {
          "value": "left",
          "label": "Slides in from the left"
        },
        {
          "value": "right",
          "label": "Slides in from the right"
        },
        {
          "value": "fade",
          "label": "Fades in"
        }
      ],
      "default": "left"
    },
    {
      "type": "radio",
      "id": "top_position",
      "label": "Starting position",
      "options": [
        {
          "value": "page",
          "label": "Beginning of page"
        },
        {
          "value": "below-header",
          "label": "Under header"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "mobile_menu_submenu_animation",
      "label": "Submenu open mode",
      "options": [
        {
          "value": "slide",
          "label": "Slide-in"
        },
        {
          "value": "dropdown",
          "label": "Drop-down"
        }
      ],
      "default": "slide"
    },
    {
      "type": "select",
      "id": "borders",
      "label": "Border between links",
      "options": [
        {
          "value": "false",
          "label": "No"
        },
        {
          "value": "main",
          "label": "Main links"
        },
        {
          "value": "true",
          "label": "All links"
        }
      ],
      "default": "true"
    },
    {
      "type": "color_scheme",
      "id": "main_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "color_scheme",
      "id": "heading_color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "heading_border",
      "label": "Border bottom"
    },
    {
      "type": "header",
      "content": "Tabs style"
    },
    {
      "type": "color_scheme",
      "id": "tabs_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "tabs_width",
      "label": "Width",
      "options": [
        {
          "value": "full",
          "label": "Full"
        },
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "container-left",
          "label": "Left container"
        }
      ],
      "default": "container"
    },
    {
      "type": "checkbox",
      "id": "tabs_border_bottom",
      "label": "Border bottom",
      "default": false
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "em",
      "label": "Content padding",
      "default": 0.5
    },
    {
      "type": "checkbox",
      "id": "sticky_tabs",
      "label": "Sticky tabs",
      "default": true,
      "info": "Tabs will stick to the top of the screen when scrolling."
    },
    {
      "type": "checkbox",
      "id": "tabs_show_scroll_hint",
      "label": "Show scroll hint",
      "default": true,
      "info": "Displays a subtle shadow on the sides to indicate more items are available when the bar overflows horizontally."
    },
    {
      "type": "paragraph",
      "content": "****************************************** Tabs settings ******************************************"
    },
    {
      "type": "range",
      "id": "tab_vertical_padding",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "em",
      "label": "Tab vertical padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "tab_horizontal_padding",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "em",
      "label": "Tab horizontal padding",
      "default": 0
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Style",
      "options": [
        {
          "value": "v1",
          "label": "Pills"
        },
        {
          "value": "v2",
          "label": "Line"
        },
        {
          "value": "plain-text",
          "label": "Plain text"
        }
      ],
      "default": "plain-text"
    },
    {
      "type": "checkbox",
      "id": "tabs_full_width",
      "label": "Stretch buttons",
      "default": false
    },
    {
      "type": "checkbox",
