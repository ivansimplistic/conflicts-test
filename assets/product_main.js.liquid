if(!customElements.get('product-price')) {
  class ProductPrice extends HTMLElement {
  	constructor() {
      super();
      this.mainElement = this.closest('.product-main-element');
      this.finalPriceElement = this.querySelector('.final');
      this.comparePriceElement = this.querySelector('.compare');
      this.multiplyQuantity = typeof(this.dataset.multiplyQuantity)!='undefined' ? this.dataset.multiplyQuantity=='true' : {{settings.show_price_by_quantity | json}}

      if(this.mainElement.classList.contains('product-card')){
        var originalPricePrefix = '<span class="visually-hidden">'+lngg.product__original_price_label+': </span>'
        var finalPricePrefix = '<span class="visually-hidden">. '+lngg.product__final_price_label+': </span>'
      }else{
        var originalPricePrefix = '<span class="visually-hidden">'+lngg.product__original_price_label+': </span>'
        var finalPricePrefix = '<span class="visually-hidden">. '+lngg.product__final_price_label+': </span>'
      }

      this.listenEvents = ['variantChange','sellingPlanChange'];
      if (this.multiplyQuantity)
        this.listenEvents.splice(1, 0, 'quantityChange');

      this._boundOnMainEvent = this._boundOnMainEvent || ((e)=>this.onMainEvent(e, originalPricePrefix, finalPricePrefix));
    }

    connectedCallback() {
      if (!this.mainElement || !this._boundOnMainEvent) return;
      this.listenEvents.forEach((event)=>{
        this.mainElement.addEventListener(event, this._boundOnMainEvent);
      });
    }

    disconnectedCallback() {
      if (!this.mainElement || !this._boundOnMainEvent) return;
      this.listenEvents.forEach((event)=>{
        this.mainElement.removeEventListener(event, this._boundOnMainEvent);
      });
    }

    onMainEvent(e, originalPricePrefix, finalPricePrefix) {
      const data = this.mainElement.getCurrentPlan() || this.mainElement.getCurrentVariant();
      let quantity = 1;
      if (data) {
        quantity = this.multiplyQuantity ? this.mainElement.getQuantity() : 1;
        this.finalPriceElement.innerHTML = $s.formatMoney(data.price * quantity).replace('.00','');

        if(data.compare_at_price > data.price) {
          this.comparePriceElement.classList.remove('hide');
          this.comparePriceElement.innerHTML = originalPricePrefix + $s.formatMoney(data.compare_at_price * quantity).replace('.00','');
          this.finalPriceElement.innerHTML = finalPricePrefix + $s.formatMoney(data.price * quantity).replace('.00','');
        } else {
          this.comparePriceElement.classList.add('hide');
          this.comparePriceElement.innerHTML = '';
        }
      } else {
        this.finalPriceElement.innerHTML = '&nbsp;';
        this.comparePriceElement.innerHTML = '';
      }
      this.mainElement.dispatchEvent(new CustomEvent('priceChange', {detail: {price: data ? data.price * quantity : null}}));
    }
  }
  customElements.define('product-price', ProductPrice);
}

if(!customElements.get('product-variants')) {
  class ProductVariantsAbstract extends HTMLElement {
    constructor() {
      super();
      this.variantsInfo = this.dataset.info ? JSON.parse(this.dataset.info) : null;
    }

    getOptionInfo(optionName) {
      return (this.variantsInfo ? this.variantsInfo.find(x=>x.title==optionName) : null) || {};
    }

    getOptionInfoIcon(optionName) {
      var info = this.getOptionInfo(optionName);
      var html = '';
      if (info.description) {
        html = `
          <div class="option-info-icon">
            <button type="button" class="btn-open">?</button>
            <div class="option-info-content animation">${info.description}</div>
          </div>
        `;
      }

      return html;
    }

    getOptionInfoLink(optionName) {
      var info = this.getOptionInfo(optionName);
      var html = '';
      if (info.link_text) {
        if (info.link_target_image) {
          html = `
            <button type="button" class="option-info-link link" data-image-width="${info.link_target_image_native_width}" data-image-height="${info.link_target_image_native_height}" data-image="${info.link_target_image}" data-width="${info.link_target_image_width}">${info.link_text}</button>
          `;
        } else {
          html = `
            <a class="option-info-link link" href="${info.link_target_url}" target="_blank">${info.link_text}</a>
          `;
        }

      }

      return html;
    }

    deselectRequiredOptions() {
      const x = this.mainElement.requiredOptions;
      x.forEach((option)=>{
        //only works for options generated in liquid, custom options are handled where they get generated in javascript.
        const element = this.querySelector('product-hvswatch[data-label="'+option+'"]');
        if (!element) return;
        element.setAttribute('data-required', 'true');

        const checkbox = element.querySelector('input:checked');
        if (checkbox) {
          checkbox.checked = false;
          checkbox.setAttribute('data-selected', 'true');
        }
      })
    }
        
    bindInfoElements() {
      this.options.forEach((element)=>{
        var infoIcon = element.querySelector('.option-info-icon');
        var infoLink = element.querySelector('.option-info-link');
        let variantsElement = element.variantsElement || element.closest('product-variants, product-high-variants');
        if (!infoIcon) {
          let html = variantsElement.getOptionInfoIcon(element.dataset.label) || '';
          if (html) {
            element.querySelector('.option-name').insertAdjacentHTML('afterbegin', html);
            infoIcon = element.querySelector('.option-info-icon');
          }
        }
        if (!infoLink) {
          let html = variantsElement.getOptionInfoLink(element.dataset.label) || '';
          if (html) {
            element.querySelector('.option-name').insertAdjacentHTML('beforeend', html);
            infoLink = element.querySelector('button.option-info-link');
          }
        }
        if (infoIcon) {
          $s.initFloatingPanel({container: infoIcon});
        }
        if (infoLink && infoLink.tagName.toLowerCase() == 'button') {
          infoLink.addEventListener('click', (e)=>{
            var imageWidthPX = parseFloat(getComputedStyle(document.documentElement).fontSize) * infoLink.dataset.width;
            var html = `
              <div class="option-info-popup-content scheme" style="width: ${infoLink.dataset.width}rem">
                <img alt="" src="${infoLink.dataset.image + (infoLink.dataset.image.indexOf('?')==-1 ? '?' : '&') + 'width='+imageWidthPX}" width="${infoLink.dataset.imageWidth}" height="${infoLink.dataset.imageHeight}" />
              </div>
            `;
            $s.openModal(html, 'option-info-popup');
          });
        }
      });
    }

  }

  class ProductVariants extends ProductVariantsAbstract {
    constructor() {
      super();
      this.mainElement = this.closest('.product-main-element');
      this.mainElement.variantsInstances = (this.mainElement.variantsInstances || 0) +1;
      this.instanceIndex = this.mainElement.variantsInstances;
      this.variantInput = this.querySelector('[data-variant-id]');
      this.options = this.querySelectorAll('[data-option]');
      this.swatchImg = this.querySelector('product-swatch[data-use-img="true"]');
      this.mainElement.addEventListener('variantChange', (event)=> {
        if (this.variantInput.value != event.detail.variant.id) {
          this.setVariant(event.detail.variant);
        }
      })

      this.bindOptions();
      setTimeout(()=>{
        this.variantChange(this.getCurrentVariant(), false);
        this.bindInfoElements();
      }, 10);
    }

    getCurrentVariant() {
      return this.mainElement.productData.variants.find(x=>x.id==this.variantInput.value)
    }

    setVariant(variant) {
      if(typeof variant !== 'object') {
        variant = this.mainElement.productData.variants.find(x=>x.id==variant);
      }
      if(variant) {
        this.refreshOptions(-1, variant);
        this.variantChange(variant);
      }
    }

    variantChange(variant, animate=true) {
      if(variant) {
        this.variantInput.value = variant.id;
        {% if settings.update_pdp_url_on_change %}
          if (this.mainElement.productData.is_product_main) {
            var url = new URL(location.href);
            url.searchParams.set('variant', variant.id);
            if (variant.product_url) {
              url.pathname = variant.product_url.split('?')[0];
            }
            history.replaceState({},'', url.toString());      
          }
        {% endif %}
      } else {
        this.variantInput.value = '';
      }
      this.previousVariant = variant;
      this.variantInput.dispatchEvent(new Event('change', {bubbles: true}));
      this.mainElement.dispatchEvent(new CustomEvent('variantChange', {detail: {variant, animate}}));

      if (this.swatchImg) {
          //var variant = this.mainElement.productData.variants.
          var optionIndex = this.swatchImg.dataset.option/1 -1;
          this.swatchImg.querySelectorAll('[type="radio"]').forEach(radio=>{
            var label = radio.parentNode.querySelector('.label-inner');
            
            var matchingVariant = this.mainElement.productData.variants.find(v => {
              if (v.options[optionIndex] !== radio.value) return false;
              // All other options must match the current variant
              for (let i = 0; i < v.options.length; i++) {
                if (i === optionIndex) continue;
                if (v.options[i] !== variant.options[i]) return false;
              }
              return true;
            });
            if (!matchingVariant) {
              matchingVariant = this.mainElement.productData.variants.find(
                v => v.options[optionIndex] == radio.value
              );
            }
            let img = label.querySelector('img');
            if (matchingVariant.featured_media) {
              if (!img) {
                img = document.createElement('img');
                img.loading = 'lazy';
                img.width = 80;
                img.height = 80;
                img.alt = '';
                label.appendChild(img);
              }
              img.src = $s.imgUrlFilter(matchingVariant.featured_media.src, '80x');
              img.style.display = '';
            } else {
              if (img) {
                img.style.display = 'none';
              }
            }
          });

      }

    }

    calculateNewVariant(optionChanged, value) {
      var newVariants = this.mainElement.productData.variants;
      this.mainElement.productData.options_with_values.forEach((option, index)=>{
        if(optionChanged==index) {
          newVariants = newVariants.filter(x=>x.options[index]==value);
        } else {
          var tmpNewVariants = this.previousVariant ? newVariants.filter(x=>x.options[index]==this.previousVariant.options[index]) : [];
          if(tmpNewVariants.length==0) {
            tmpNewVariants = newVariants.filter(x=>x.options[index]==newVariants[0].options[index]);
          }
          newVariants = tmpNewVariants;
        }
      });
      return newVariants[0];
    }

    bindOptions() {
      this.options.forEach((element)=>{
        element.addEventListener('change', (e)=>{
          let optionIdx = element.dataset.option-1;
          let variant = this.calculateNewVariant(optionIdx, e.target.value);
          this.refreshOptions(element.dataset.option-1, variant);
          this.variantChange(variant);
        });
      });
    }

    // Get values with availability that depends on previous options
    getOptionValues(currentVariant) {
      var options = [];
      var variants = this.mainElement.productData.variants;
      options = structuredClone(this.mainElement.productData.options_with_values.map(x=>x.values));
      options.forEach((values, index) => {
        // Filter variants that match previous selections
        let filteredVariants = variants;
        for (let prev = 0; prev < index; prev++) {
          filteredVariants = filteredVariants.filter(
            v => v.options[prev] === currentVariant.options[prev]
          );
        }
        let retValues = [];
        values.forEach((valueObj) => {
          const matchingVariants = filteredVariants.filter(
            v => v.options[index] === valueObj.value
          );
          if (matchingVariants.length > 0) {
            valueObj.available = matchingVariants.some(v => v.available);
            retValues.push(valueObj);
          }
        })
        options[index] = retValues;
      });
      return options;
    }

    refreshOptions(updateOptionIndex=-1, currentVariant) {
      var optionValues = this.getOptionValues(currentVariant);
      this.options.forEach((element)=>{
        let index = element.dataset.option - 1;
        if(index > updateOptionIndex) {
          element.buildOptions(optionValues[index], currentVariant.options[index]);
        }
        var optionValueElement = element.querySelector('.option-value');
        if(optionValueElement) {
          optionValueElement.innerHTML = currentVariant.options[index];
        }
      });
    }
  }
  customElements.define('product-variants', ProductVariants);

  class ProductHighVariants extends ProductVariantsAbstract {
    constructor() {
      super();
      this.mainElement = this.closest('.product-main-element');
      this.currentValues = this.getSelectedValues();
      this.variantInput = this.querySelector('[data-variant-id]');
      this.addEventListener('change', this.onVariantChange.bind(this));
      this.mainElement.dispatchEvent(new CustomEvent('variantChange', {detail: {variant: this.getCurrentVariant()}}));
      this.options = this.querySelectorAll('[data-option]');
      this.deselectRequiredOptions();
      this.bindInfoElements();
    }
    
    getCurrentVariant() {
      return this.mainElement.productData.variants.find(x=>x.id==this.variantInput.value)
    }

    onVariantChange(e) {
      let productChanged = false;
      const fieldLabel = e.target.closest('product-hvswatch, product-hvdropdown').dataset.label;
      this.focusSelector = '[data-label="'+fieldLabel+'"] input[value="'+e.target.value+'"], [data-label="'+fieldLabel+'"] select'; 
      this.productUrl = this.mainElement.dataset.productUrl;
      if (this.mainElement.required(fieldLabel)) {
        this.mainElement.required(fieldLabel, false); //remove option from required fields
      }
      if (e.target.dataset.productUrl) {
        this.productUrl = e.target.dataset.productUrl;
        productChanged = true;
      } else if (e.target.tagName == 'SELECT' && e.target.options[e.target.selectedIndex].dataset.productUrl) {
        this.productUrl = e.target.options[e.target.selectedIndex].dataset.productUrl;
        productChanged = true;
      }
      //get all selected input values inside the component
      let values = this.getSelectedValues();
      if (!productChanged && this.currentValues == values) {
        this.mainElement.dispatchEvent(new CustomEvent('variantChange', {detail: {variant: this.mainElement.getCurrentVariant()}}));
        return;
      }
      this.currentValues = values;

      this.updateProductHtml(values, productChanged, e.target.dataset.variantid);

    }

    getSelectedValues() {
      let inputs = this.querySelectorAll('product-hvswatch input:checked, product-hvdropdown select, input.hidden-option-value');
      let values = [];
      inputs.forEach(input=>{
        if(input.tagName=='INPUT') {
          values.push(input.value);
        } else if(input.tagName=='SELECT') {
          values.push(input.value);
        }
      });
      return values.join(',');
    }

    updateProductHtml(values, productChanged, variantid) {
      // Always capture state before making changes, so we can restore it even when switching products
      let urlObj = new URL(this.productUrl, window.location.origin);
      urlObj.searchParams.set('option_values', values);
      if (productChanged && variantid) {
        urlObj.searchParams.set('variant', variantid);
        urlObj.searchParams.delete('option_values');
      } 
      const isPDP = this.mainElement.productData.is_product_main;
      const isCurrentPDP = isPDP && location.href.indexOf('/products/') > -1 && this.mainElement === document.querySelector('.product-main-element') && this.closest('.tingle-modal') == null;
      const loadOnlyProductMainSection = isPDP && !productChanged;
      const currentSectionElement = this.mainElement.closest('.shopify-section');
      const currentSectionId = currentSectionElement?.id ? currentSectionElement.id.replace(/^shopify-section-/, '') : null;
      if (!isPDP) {
        urlObj.searchParams.set('section_id', 'product_card_ajax');
      } else if(loadOnlyProductMainSection) {
        // Use the actual section instance id (template--...__product_main), not the section type id.
        urlObj.searchParams.set('section_id', currentSectionId || 'product_main');
      }
      const getUrl = urlObj.toString().replaceAll('%2C', ',');

      if (self.requestController) {
        self.requestController.abort();
      }
      self.requestController = new AbortController();
      const bodyHadAnimationSpeed0 = document.body.classList.contains('animation-speed-0');
      
      this.productRequest = $s.get({
        url: getUrl,
        signal: self.requestController.signal,
        success: async (data)=>{
          const savedScrollY = isCurrentPDP ? window.scrollY : null;
          if (isCurrentPDP) {
            this.mainElement.dataset.replacingInfo = 'true';
          }
          if (!bodyHadAnimationSpeed0) {
            document.body.classList.add('animation-speed-0');
          }
          let mainElement;
          let newDom = new DOMParser().parseFromString(data, 'text/html');

          const newMainElement = newDom.querySelector('.product-main-element');

          const previousState = this.captureInteractiveState();

          if (isCurrentPDP && !loadOnlyProductMainSection) {
            //replace other template sections that don't contain shopify-app-block
            //main section is updated more carefully after this
            await (async ()=>{
              const ignoreAppBlocks = true;
              let currentSections = Array.from(this.closest('main').querySelectorAll('.shopify-section'));
              let newSections = Array.from(newDom.querySelectorAll('main .shopify-section'));
              let newMainDom = newDom.querySelector('main');
              currentSections.forEach((section, index)=>{
                if (ignoreAppBlocks && section.querySelector('.shopify-app-block')) {
                  return;
                }
                if (section.contains(this.mainElement)) {
                  return;
                }
                const newSectionMatch = newMainDom.querySelector('.shopify-section[id="'+section.id+'"]');
                if (!newSectionMatch) {
                  section.remove();
                }
              });
              let lastSectionAdded = null;
              for (let index = 0; index < newSections.length; index++) {
                let section = newSections[index];
                if (section.contains(newMainElement)) {
                  lastSectionAdded = this.mainElement.closest('.shopify-section');
                  continue;
                } 
                const currentSection = currentSections.find(x=>x.id==section.id);
                if (currentSection) {
                  const parent = currentSection.parentNode;
                  currentSection.outerHTML = section.outerHTML;
                  const updatedSection = parent.querySelector(`#${section.id}`);
                  lastSectionAdded = updatedSection;
                  await $s.globalEval(lastSectionAdded);
                  continue;
                }
                  
                if (lastSectionAdded) {
                  lastSectionAdded.insertAdjacentHTML('afterend', section.outerHTML);
                  lastSectionAdded = lastSectionAdded.nextElementSibling;
                } else {
                  const currentMainDom = this.closest('main');
                  currentMainDom.insertAdjacentHTML('afterbegin', section.outerHTML);
                  lastSectionAdded = currentMainDom.firstElementChild;
                }
                await $s.globalEval(lastSectionAdded);

              }
            })();
              
          }

          if (productChanged || !isPDP) {
            // Combined listing: product changed
            const currentMainElement = this.mainElement;
            this.mainElement.innerHTML = '';
            newMainElement.requiredOptions = currentMainElement.requiredOptions;
            this.mainElement.insertAdjacentElement('beforebegin', newMainElement);
            this.mainElement.remove();
            mainElement = newMainElement;
            $s.globalEval(mainElement);
          } else {
            // Same product, different variant: replace info block
            const newProductJsonElement = newDom.querySelector('[type="application/json"][data-product-json]');
            const newProductJsonData = JSON.parse(newProductJsonElement.textContent);
            const newInfo = newDom.querySelector('.main-product-info');
            const currentInfo = this.mainElement.querySelector('.main-product-info');
            const scrollAnchorContainer = this.mainElement.closest('main') || document.documentElement;
            const previousOverflowAnchor = scrollAnchorContainer.style.overflowAnchor;
            scrollAnchorContainer.style.overflowAnchor = 'none';
            // Update product data before compomonents get created.
            this.mainElement.updateProductData(newProductJsonData);

            // Keep the same DOM node to reduce sticky/scroll recalculations.
            currentInfo.innerHTML = newInfo.innerHTML;
            $s.globalEval(currentInfo);
            requestAnimationFrame(() => {
              scrollAnchorContainer.style.overflowAnchor = previousOverflowAnchor;
            });
  
            mainElement = this.mainElement;
            mainElement.updateRefs();
              
          }

          //mainElement is now the new instance
          
          // Restore interactive state for both same-product and cross-product changes
          this.restoreInteractiveState(mainElement, previousState);
          mainElement.dispatchEvent(new CustomEvent('variantChange', {detail: {variant: mainElement.getCurrentVariant()}}));

          // Original focus logic for same-product variant changes
          const targetFocusElement = mainElement.variantsElement?.querySelector(this.focusSelector);
          if (this.focusSelector && targetFocusElement && targetFocusElement !== document.activeElement) {
            try {
              targetFocusElement.focus({ preventScroll: true });
            } catch (e) {
              targetFocusElement.focus();
            }
          }

          //update browser url when seeing the PDP of the same product that was updated.
          if (isCurrentPDP) {
            const browserUrl = new URL(getUrl, window.location.origin);
            browserUrl.searchParams.delete('section_id');
            history.replaceState(null, null, browserUrl.href.replaceAll('%2C', ','));
          }

          /* begin refresh apps */
          
          //fix states after restoring input values.
          mainElement.querySelectorAll('personalize-field').forEach((field)=>{
            if (typeof field.refresh === 'function') {
              field.refresh();
            }
          });          

          /* end refresh apps */

          if (savedScrollY !== null) {
            window.scrollTo(0, savedScrollY);
            requestAnimationFrame(() => window.scrollTo(0, savedScrollY));
          }
          if (isCurrentPDP) {
            requestAnimationFrame(() => {
              delete this.mainElement.dataset.replacingInfo;
            });
          }

          if (!bodyHadAnimationSpeed0) {
            document.body.classList.remove('animation-speed-0');
          }
  
        }
        ,
        error: ()=>{
          if (isCurrentPDP) {
            delete this.mainElement.dataset.replacingInfo;
          }
          if (!bodyHadAnimationSpeed0) {
            document.body.classList.remove('animation-speed-0');
          }
        }
      });
    }

    // Capture interactive components state that we want to preserve
    // (quantity, accordions, personalization inputs, etc.)
    // Excludes anything inside product-high-variants, which should always come from new HTML
    captureInteractiveState() {
      const state = {
        quantity: null,
        accordions: {},
        tabs: {},
        fields: {},
        customValues: {},
        customPersonalizationFormSelectionId: null
      };

      if (!this.mainElement) {
        return state;
      }

      const info = this.mainElement.querySelector('.main-product-info');
      if (!info) {
        return state;
      }

      state.customValues.requiredOptions = this.mainElement.requiredOptions;

      // Quantity - only if not inside product-high-variants
      const qtyInput = info.querySelector('.quantity-input.is-main-input');
      if (qtyInput && !qtyInput.closest('product-high-variants')) {
        state.quantity = qtyInput.value;
      }

      // Accordions (including enhanced description) - only if not inside product-high-variants
      info.querySelectorAll('.accordion').forEach((acc)=>{
        // Skip accordions inside product-high-variants
        if (acc.closest('product-high-variants')) {
          return;
        }
        const panel = acc.querySelector('.accordion-panel');
        const trigger = acc.querySelector('.accordion-trigger');
        if (!panel) return;
        const panelId = panel.id || null;
        if (!panelId) return;
        const isOpen = acc.classList.contains('open') ||
          (trigger && trigger.getAttribute('aria-expanded') === 'true');
        state.accordions[panelId] = { open: isOpen };
      });

      info.querySelectorAll('util-tabs[id]').forEach((tab)=>{
        state.tabs[tab.id] = tab.activeTabIndex();
      });

      // "No personalization" vs addon radios — not under .personalize-field (see custom_personalization_form)
      const personalizeFormToggle = info.querySelector('input[name="custom-personalization-form"]:checked');
      if (personalizeFormToggle && !personalizeFormToggle.closest('product-high-variants') && personalizeFormToggle.id) {
        state.customPersonalizationFormSelectionId = personalizeFormToggle.id;
      }

      // Personalization inputs / other inputs where it makes sense to preserve the value
      // Exclude anything inside product-high-variants
      info.querySelectorAll(
        '[data-preserve-state], .personalize-field input, .personalize-field textarea, .personalize-field select'
      ).forEach((el)=>{
        // Skip elements inside product-high-variants
        if (el.closest('product-high-variants')) {
          return;
        }
        // Radio groups share the same name; use id so each input's checked state is preserved
        let key = el.id || el.name;
        if (el.type === 'radio' && el.id) {
          key = el.id;
        }
        if (!key) return;
        const entry = state.fields[key] || {};

        if (el.tagName === 'SELECT') {
          entry.value = el.value;
        } else if (el.type === 'checkbox' || el.type === 'radio') {
          entry.checked = el.checked;
        } else {
          entry.value = el.value;
        }

        state.fields[key] = entry;
      });

      return state;
    }

    // Restore captured state into the new DOM, only where equivalent components exist
    // Excludes anything inside product-high-variants, which should always come from new HTML
    restoreInteractiveState(mainElement, state) {
      if (!mainElement || !state) return;

      const info = mainElement.querySelector('.main-product-info');
      if (!info) return;

      mainElement.requiredOptions = state.customValues.requiredOptions;

      // Quantity - only restore if not inside product-high-variants
      if (state.quantity !== null) {
        const qtyInput = info.querySelector('.quantity-input.is-main-input');
        if (qtyInput && !qtyInput.closest('product-high-variants')) {
          qtyInput.value = state.quantity;
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      // Accordions - restore open/closed state where panel IDs match (best-effort matching)
      // Only restore accordions that are not inside product-high-variants
      Object.keys(state.accordions || {}).forEach((panelId)=>{
        const saved = state.accordions[panelId];
        const panel = info.querySelector('#'+CSS.escape(panelId));
        if (!panel) return;
        // Skip if accordion is inside product-high-variants
        if (panel.closest('product-high-variants')) {
          return;
        }
        const acc = panel.closest('.accordion');
        const trigger = info.querySelector('[aria-controls="'+panelId+'"]');
        if (!acc) return;

        if (saved.open) {
          acc.classList.add('open');
          panel.classList.add('expandable-default-open');
          if (trigger) {
            trigger.setAttribute('aria-expanded', 'true');
          }
        } else {
          acc.classList.remove('open');
          panel.classList.remove('expandable-default-open');
          if (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
          }
        }
      });

      // Tabs - restore active tab where panel IDs match
      Object.keys(state.tabs || {}).forEach((panelId)=>{
        const saved = state.tabs[panelId];
        const utilTab = info.querySelector('util-tabs#'+CSS.escape(panelId));
        if (!utilTab) return;
        utilTab.activateTabByIndex(saved);
        utilTab.refresh();
      });

      // No personalization vs addon selection (must run before field restore so name attributes match selection)
      if (state.customPersonalizationFormSelectionId) {
        const toggle = info.querySelector(`#${CSS.escape(state.customPersonalizationFormSelectionId)}`);
        if (toggle && toggle.name === 'custom-personalization-form' && !toggle.closest('product-high-variants')) {
          toggle.checked = true;
          toggle.dispatchEvent(new CustomEvent('change', { bubbles: true, detail: { loadingState: true } }));
        }
      }

      // Other fields (personalization, etc.) - only restore if not inside product-high-variants
      // Do not use CSS.escape() inside [name="..."]: it escapes [] and breaks Shopify property names like properties[Foo]
      const findPreservedFieldElements = (root, key) => {
        const set = new Set();
        const byId = root.querySelector(`#${CSS.escape(key)}`);
        if (byId) {
          set.add(byId);
          return set;
        }
        root.querySelectorAll('[name]:not([id])').forEach((el) => {
          if (el.name === key) set.add(el);
        });
        root.querySelectorAll('[data-field-name]:not([id])').forEach((el) => {
          if (el.getAttribute('data-field-name') === key) set.add(el);
        });
        root.querySelectorAll('[data-name]:not([id])').forEach((el) => {
          if (el.getAttribute('data-name') === key) set.add(el);
        });
        return set;
      };

      Object.keys(state.fields || {}).forEach((key)=>{
        const fieldState = state.fields[key];
        const candidates = findPreservedFieldElements(info, key);
        candidates.forEach((el)=>{
          // Skip if field is inside product-high-variants
          if (el.closest('product-high-variants')) {
            return;
          }
          if (el.tagName === 'SELECT') {
            if (typeof fieldState.value !== 'undefined') {
              el.value = fieldState.value;
              el.dispatchEvent(new Event('change', { bubbles: true }));
            }
          } else if (el.type === 'checkbox' || el.type === 'radio') {
            if (typeof fieldState.checked !== 'undefined') {
              el.checked = fieldState.checked;
              el.dispatchEvent(new Event('change', { bubbles: true }));
            }
          } else if (typeof fieldState.value !== 'undefined') {
            el.value = fieldState.value;
            el.dispatchEvent(new Event('input', { bubbles: true }));
          }
        });
      });
    }
    
  }
  customElements.define('product-high-variants', ProductHighVariants);
}

